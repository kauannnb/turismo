generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Destination {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  state       String    @db.VarChar(2)
  region      String
  description String    @db.Text
  coverImage  String
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  packages    Package[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  packages Package[]
}

model Package {
  id               Int            @id @default(autoincrement())
  title            String
  slug             String         @unique
  shortDescription String
  description      String         @db.Text
  price            Decimal        @db.Decimal(10, 2)
  durationDays     Int
  departureCity    String
  coverImage       String
  included         Json
  notIncluded      Json
  itinerary        Json
  featured         Boolean        @default(false)
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  destinationId    Int
  destination      Destination    @relation(fields: [destinationId], references: [id])
  categoryId       Int
  category         Category       @relation(fields: [categoryId], references: [id])
  images           PackageImage[]
  departures       Departure[]
  testimonials     Testimonial[]

  @@index([destinationId])
  @@index([categoryId])
}

model PackageImage {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String
  order     Int     @default(0)
  packageId Int
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model Departure {
  id             Int      @id @default(autoincrement())
  departureDate  DateTime
  returnDate     DateTime
  spotsTotal     Int
  spotsAvailable Int
  price          Decimal? @db.Decimal(10, 2)
  packageId      Int
  package        Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, departureDate])
}

model Testimonial {
  id         Int      @id @default(autoincrement())
  authorName String
  authorCity String
  text       String   @db.Text
  rating     Int
  createdAt  DateTime @default(now())
  packageId  Int?
  package    Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
